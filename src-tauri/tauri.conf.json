{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "fmless",
    "version": "0.1.0",
    "identifier": "com.fmless.app",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "decorations": false,
                "title": "fmless",
                "label": "overlay",
                "title": "Overlay",
                "fullscreen": false,
                "maximized": true,
                "visibleOnAllWorkspaces": true,
                "alwaysOnTop": true,
                "decorations": false,
                "hiddenTitle": true,
                "transparent": true,
                "resizable": false,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
